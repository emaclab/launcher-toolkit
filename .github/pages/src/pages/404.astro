---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = import.meta.env.BASE_URL;
---

<StarlightPage
	frontmatter={{
		title: 'Page not found',
		description: 'Find setup guides, the bridge reference, and pack-building instructions for Launcher Toolkit.',
		template: 'splash',
		editUrl: false,
		pagefind: false,
	}}
>
	<p>This documentation page does not exist. Its address may have changed.</p>
	<ul>
		<li><a href={`${base}getting-started/overview/`}>Start with the overview</a>.</li>
		<li><a href={`${base}getting-started/quickstart/`}>Follow the quickstart</a>.</li>
		<li><a href={`${base}reference/bridge/`}>Read the bridge reference</a>.</li>
		<li><a href={`${base}guides/build/`}>Build a pack</a>.</li>
	</ul>
	<p>Use <strong>Search developer docs</strong> to find a command, configuration key, or bridge member.</p>
</StarlightPage>
